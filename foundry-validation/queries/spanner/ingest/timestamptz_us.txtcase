// Preserve the upstream timestamp input and instants; read back in UTC with an exact supported unit.

// part: metadata

[setup.connection.options]
"spanner.max_timestamp_precision" = { apply = "microseconds", revert = "nanoseconds_error_on_overflow" }

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "l",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "tsu:UTC",
            "flags": ["nullable"]
        },
        {
            "name": "value2",
            "format": "tsu:UTC",
            "flags": ["nullable"]
        }
    ]
}
