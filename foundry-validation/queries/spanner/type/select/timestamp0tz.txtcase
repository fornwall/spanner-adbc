// Use native GoogleSQL types; preserve the upstream values and assert the canonical Arrow schema.

// part: metadata

[setup]
drop = "test_timestamptz"

[setup.connection.options]
"spanner.max_timestamp_precision" = { apply = "microseconds", revert = "nanoseconds_error_on_overflow" }

// part: expected

{"res": 1684158330000000}
{"res": 946684800000000}
{"res": -14182940000000}
{"res": -62135596800000000}
{"res": 253402300799000000}
{"res": null}

// part: setup_query

CREATE TABLE test_timestamptz (
    idx INT64,
    res TIMESTAMP
);

INSERT INTO test_timestamptz (idx, res) VALUES (1, TIMESTAMP '2023-05-15 13:45:30+00');
INSERT INTO test_timestamptz (idx, res) VALUES (2, TIMESTAMP '2000-01-01 00:00:00+00');
INSERT INTO test_timestamptz (idx, res) VALUES (3, TIMESTAMP '1969-07-20 20:17:40+00');
INSERT INTO test_timestamptz (idx, res) VALUES (4, TIMESTAMP '0001-01-01 00:00:00+00');
INSERT INTO test_timestamptz (idx, res) VALUES (5, TIMESTAMP '9999-12-31 23:59:59+00');
INSERT INTO test_timestamptz (idx, res) VALUES (6, NULL);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsu:UTC",
            "flags": ["nullable"]
        }
    ]
}
