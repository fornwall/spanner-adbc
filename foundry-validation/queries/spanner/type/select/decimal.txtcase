// Use native GoogleSQL types; preserve the upstream values and assert the canonical Arrow schema.

// part: setup_query

CREATE TABLE test_decimal (
    idx INT64,
    res NUMERIC
);

INSERT INTO test_decimal (idx, res) VALUES (1, 123.45);
